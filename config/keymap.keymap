#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mkp_input_listener {
    //左クリック後0.18秒でレイヤー5を抜ける

    input-processors = <&zip_temp_layer 5 180>;
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        mt_controlled: mod_tap_controlled {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_for_mac {
            bindings = <
&mt LG(LS(N4)) ESC  &kp Q             &kp W         &kp E             &kp R             &kp T        &kp Y         &kp U        &kp I          &kp O       &kp P                    &kp DELETE
&kp TAB             &kp A             &kp S         &kp D             &kp F             &kp G        &kp H         &kp J        &kp K          &kp L       &mt_controlled SQT SEMI  &mt_controlled EQUAL MINUS
&kp LSHFT           &kp Z             &kp X         &kp C             &kp V             &kp B        &kp SPACE     &mo 2        &kp N          &kp M       &kp COMMA                &kp DOT                     &kp SLASH  &mt_controlled RIGHT_SHIFT BACKSLASH
&tog 5              &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LC(UP_ARROW)  &kp LEFT_COMMAND  &lt 2 SPACE  &lt 3 ESCAPE  &lt 3 ENTER  &kp BACKSPACE  &kp C_MUTE  &kp C_VOLUME_DOWN        &kp C_VOLUME_UP
            >;
        };

        lower_layer_for_windows {
            bindings = <
&mt PRINTSCREEN ESC  &kp Q     &kp W     &kp E                       &kp R      &kp T        &kp Y      &kp U        &kp I          &kp O       &kp P                    &kp DELETE
&kp TAB              &kp A     &kp S     &kp D                       &kp F      &kp G        &kp H      &kp J        &kp K          &kp L       &mt_controlled SQT SEMI  &mt_controlled EQUAL MINUS
&kp LSHFT            &kp Z     &kp X     &kp C                       &kp V      &kp B        &kp SPACE  &mo 2        &kp N          &kp M       &kp COMMA                &kp DOT                     &kp FSLH  &mt_controlled RSHFT BACKSLASH
&tog 5               &kp LGUI  &kp LALT  &mt_controlled LANG2 LANG1  &kp LCTRL  &lt 2 SPACE  &lt 3 ESC  &lt 3 ENTER  &kp BACKSPACE  &kp C_MUTE  &kp C_VOLUME_DOWN        &kp C_VOLUME_UP
            >;
        };

        fn_num_layer {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &kp N7  &kp N8      &kp N9  &kp PLUS         &kp ASTERISK  &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &kp N4  &kp N5      &kp N6  &kp MINUS        &kp SLASH     &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans   &trans  &kp KP_DOT  &kp N1  &kp N2           &kp N3        &trans   &trans  &trans
&trans  &trans   &trans   &trans  &trans  &trans   &trans  &trans      &kp N0  &kp RC(RS(TAB))  &kp RC(TAB)   &kp F12
            >;
        };

        other_layer {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR            &kp PERCENT            &kp PG_UP  &kp HOME  &kp UP        &kp END           &trans  &trans
&trans  &kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PG_DN  &kp LEFT  &kp DOWN      &kp RIGHT         &trans  &trans
&trans  &kp GRAVE        &kp APOS       &kp SEMI      &kp LBKT              &kp RBKT               &kp LANG2  &trans    &kp LG(LEFT)  &kp LG(LC(LEFT))  &trans  &kp LC(LG(RIGHT))  &kp LG(RIGHT)  &trans
&trans  &trans           &trans         &trans        &trans                &trans                 &kp LANG1  &trans    &trans        &trans            &trans  &trans
            >;
        };

        bt_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_NXT
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &to 0         &to 1
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &out OUT_USB  &out OUT_BLE  &trans        &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL
            >;
        };

        track_ball {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mo 6   &trans     &trans  &trans     &trans  &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans  &kp LA(F4)
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_FunBtlayer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};
