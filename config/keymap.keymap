#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mkp_input_listener {
    //クリック後1秒でAMLを抜ける
    input-processors = <&zip_temp_layer 5 1000>;
};

/ {
    combos {
        compatible = "zmk,combos";

        to_scroll_layer {
            bindings = <&mo 6>;
            key-positions = <20 21>;
        };

        to_gesture_layer {
            bindings = <&mo 7>;
            key-positions = <8 9>;
            require-prior-idle-ms = <150>;
        };
    };

    behaviors {
        mt_controlled: mod_tap_controlled {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_for_mac {
            bindings = <
&mt LG(LS(N4)) ESC  &kp Q             &kp W         &kp E             &kp R             &kp T        &kp Y         &kp U          &kp I          &kp O            &kp P                    &kp DELETE
&kp TAB             &kp A             &kp S         &kp D             &kp F             &kp G        &kp H         &kp J          &kp K          &kp L            &mt_controlled SQT SEMI  &mt_controlled EQUAL MINUS
&kp LSHFT           &kp Z             &kp X         &kp C             &kp V             &kp B        &kp SPACE     &kp BACKSPACE  &kp N          &kp M            &kp COMMA                &kp DOT                     &kp SLASH  &mt_controlled RIGHT_SHIFT BACKSLASH
&kp TAB             &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LC(UP_ARROW)  &kp LEFT_COMMAND  &lt 2 SPACE  &lt 3 ESCAPE  &lt 3 ENTER    &kp BACKSPACE  &kp RC(RS(TAB))  &kp RC(TAB)              &kp F12
            >;
        };

        lower_layer_for_windows {
            bindings = <
&mt PRINTSCREEN ESC  &kp Q     &kp W     &kp E                       &kp R      &kp T        &kp Y      &kp U        &kp I   &kp O   &kp P                    &kp DELETE
&kp TAB              &kp A     &kp S     &kp D                       &kp F      &kp G        &kp H      &kp J        &kp K   &kp L   &mt_controlled SQT SEMI  &mt_controlled EQUAL MINUS
&kp LSHFT            &kp Z     &kp X     &kp C                       &kp V      &kp B        &kp SPACE  &trans       &kp N   &kp M   &kp COMMA                &kp DOT                     &kp FSLH  &mt_controlled RSHFT BACKSLASH
&trans               &kp LGUI  &kp LALT  &mt_controlled LANG2 LANG1  &kp LCTRL  &lt 2 SPACE  &lt 3 ESC  &lt 3 ENTER  &trans  &trans  &trans                   &trans
            >;
        };

        fn_num_layer {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &kp N7  &kp N8        &kp N9  &kp PLUS   &kp ASTERISK  &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &kp N4  &kp N5        &kp N6  &kp MINUS  &kp SLASH     &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans   &trans  &kp KP_DOT    &kp N1  &kp N2     &kp N3        &kp EQUAL  &trans  &trans
&trans  &trans   &trans   &trans  &trans  &trans   &trans  &kp NUMBER_0  &trans  &trans     &trans        &trans
            >;
        };

        other_layer {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR            &kp PERCENT            &kp PG_UP  &kp HOME  &kp UP        &kp END           &trans             &trans
&trans  &kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PG_DN  &kp LEFT  &kp DOWN      &kp RIGHT         &trans             &trans
&trans  &kp GRAVE        &kp APOS       &kp SEMI      &kp LBKT              &kp RBKT               &trans     &trans    &kp LG(LEFT)  &kp LG(LC(LEFT))  &trans             &kp LC(LG(RIGHT))  &kp LG(RIGHT)  &trans
&trans  &trans           &trans         &kp LANG2     &kp LANG1             &trans                 &trans     &trans    &trans        &kp C_MUTE        &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
            >;
        };

        bt_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_NXT
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &to 0         &to 1
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &out OUT_USB  &out OUT_BLE  &trans        &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL
            >;
        };

        mouse_layer {
            bindings = <
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans
&kp LA(F4)  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
            >;
        };

        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        gesture_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_FunBtlayer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};
